{
  "name": "xnote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet place for your thoughts. Local-first notes.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:desktop": "node --import tsx scripts/dev.ts --desktop",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/build-electron.ts",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:desktop": "node --import tsx scripts/test-desktop.ts",
    "format": "prettier --write src server electron scripts tests *.ts *.json index.html README.md docs",
    "test:ui": "node --import tsx scripts/verify-ui.ts",
    "test:ui:round3": "node --import tsx scripts/verify-ui-round3.ts",
    "test:ui:round4": "node --import tsx scripts/verify-ui-round4.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.1",
    "@playwright/test": "^1.56.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.xnote.desktop",
    "productName": "xnote",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "icon": "build/icon.png",
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "xnote contributors"
}
